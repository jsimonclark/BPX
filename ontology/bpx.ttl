<https://w3id.org/emmo/application/bpx>
    rdf:type owl:Ontology ;
    owl:versionIRI <https://w3id.org/emmo/application/bpx/1.1.1/bpx> ;
    owl:versionInfo "1.1.1" ;
    owl:imports <https://w3id.org/emmo/domain/battery/0.20.2/battery> ,
        <https://w3id.org/emmo/domain/electrochemistry/0.37.2/electrochemistry> ;
    dcterms:title "BPX Application Ontology"@en ;
    dcterms:abstract "Classes for the parameters of the Battery Parameter eXchange (BPX) format, one class per schema field, defined under the EMMO domain ontologies for electrochemistry and batteries. Polarity and particle phase are not part of the classes: they follow from where a value sits in a BPX file. Generated from the pydantic schema of the bpx package and a curated mapping table, and versioned with it."@en ;
    dcterms:license <https://spdx.org/licenses/MIT.html> ;
    dcterms:source <https://github.com/FaradayInstitution/BPX> ;
    vann:preferredNamespacePrefix "bpx" ;
    vann:preferredNamespaceUri "https://w3id.org/emmo/application/bpx#" ;
    rdfs:comment "Generated by ontology/generate.py from bpx 1.1.1. Edit mapping.yaml instead."@en .

########################################################################################
#    Annotation properties
########################################################################################

###  https://w3id.org/emmo/application/bpx#bpx_73649a66_38f7_40ee_a51f_468b5b6049df  bpxPath
:bpx_73649a66_38f7_40ee_a51f_468b5b6049df
    rdf:type owl:AnnotationProperty ;
    skos:prefLabel "bpxPath"@en ;
    emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "Where the value sits in a BPX file: the keys from the top of the file down, joined by \"/\". A \"*\" stands for a key the file author chooses, such as the name of a particle phase in a blended electrode, of an active material in a per-material State value, or of a validation experiment. The paths are those of the BPX version given by owl:versionInfo."@en .

###  https://w3id.org/emmo/application/bpx#bpx_c167e5a9_8c89_42c8_809a_bf27cb66ec66  bpxUnit
:bpx_c167e5a9_8c89_42c8_809a_bf27cb66ec66
    rdf:type owl:AnnotationProperty ;
    skos:prefLabel "bpxUnit"@en ;
    emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "Unit of the value as written in square brackets in the BPX key, for example \"m2.s-1\". Keys without a unit hold dimensionless values and have no bpxUnit."@en .

